# Dash0 Configuration
# Get your token from: https://app.dash0.com → Settings → Auth Tokens

DASH0_AUTH_TOKEN=your_token_here

# Your Dash0 region endpoint
# Check your Dash0 URL to determine your region:
# - US West: https://ingress.us-west-2.aws.dash0.com:4317
# - EU West: https://ingress.eu-west-1.aws.dash0.com:4317
DASH0_ENDPOINT=https://ingress.us-west-2.aws.dash0.com:4317

# Dataset the telemetry lands in, and the environment name it is tagged with
DASH0_DATASET=default
DASH0_ENVIRONMENT=local

# Optional: browser monitoring for the frontend (Dash0 Web SDK).
# Leave both empty to keep the frontend uninstrumented; the three backend
# services are unaffected either way.
#
# DASH0_WEBSITE_ENDPOINT is the "OTLP via HTTP" endpoint for your region
# (https://app.dash0.com/settings/endpoints), WITHOUT any /v1/... path:
# - US West: https://ingress.us-west-2.aws.dash0.com
# - EU West: https://ingress.eu-west-1.aws.dash0.com
#
# This token is served to every visitor's browser. Create a SEPARATE token
# restricted to "Ingesting" permission only, and do not reuse DASH0_AUTH_TOKEN.
DASH0_WEBSITE_ENDPOINT=
DASH0_WEBSITE_AUTH_TOKEN=

# Optional: Enable debugging scenarios
SLOW_KITCHEN=false
NO_DRIVERS=false
ERROR_RATE=0
